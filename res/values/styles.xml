<resources>
	<!-- res/values/styles.xml -->

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>

    <style name="AppTheme.Toolbar" parent="ThemeOverlay.AppCompat.Light">
        <!-- Title text color -->
        <item name="android:textColorPrimary">@color/toolbar_title_color</item>
        <!-- Overflow & menu icon tint -->
        <item name="colorControlNormal">@color/toolbar_icon_color</item>
    </style>

    <style name="AppTheme.PopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">@color/toolbar_title_color</item>
    </style>

</resources>

